command = zsh
shell-integration = none
confirm-close-surface = false
theme = Wisteria Dusk

font-family = JetBrainsMono Nerd Font
font-size = 18

# The native cursor is hidden; shaders/cursor-pulse.glsl draws it instead,
# growing out from its center and shrinking back.
cursor-style = block
cursor-style-blink = false
cursor-opacity = 0
cursor-text = cell-foreground
custom-shader = shaders/cursor-pulse.glsl
custom-shader-animation = true

background-opacity = 0.75


window-save-state = never
window-width = 78
window-height = 23
window-padding-x = 24
window-padding-y = 24
window-decoration = false
window-theme = auto

scrollbar = never
